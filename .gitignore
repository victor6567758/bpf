# ---- Build artifacts --------------------------------------------------------
# CMake/ninja output (both the host CLion dir and the in-container `build/`).
cmake-build-*/
build/
*.o
*.a
*.so
*.skel.h          # generated by bpftool from the .bpf.o at build time

# Compiled BPF object (regenerated every build from bpf/*.bpf.c).
bpf/*.bpf.o

# ---- Capture / runtime output ----------------------------------------------
# The output dir is a bind-mount target; its contents are generated at runtime.
# Keep the directory (via the .gitkeep below) but ignore everything in it.
output/*
!output/.gitkeep

# ---- Docker ----------------------------------------------------------------
# Local override files for compose.
docker-compose.override.yml
.env

# ---- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store