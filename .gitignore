# ---- Build artifacts --------------------------------------------------------
# CMake/ninja output (CLion dirs, in-container `build/`, and per-subproject
# standalone build dirs). Patterns are depth-agnostic so they apply to both
# the root build and each partN/build.
cmake-build-*/
build/
*.o
*.a
*.so
*.skel.h          # generated by bpftool from the .bpf.o at build time

# Compiled BPF object (regenerated every build from bpf/*.bpf.c).
*.bpf.o

# ---- Capture / runtime output ----------------------------------------------
# part1's output/ dir is a bind-mount target; its contents are generated at
# runtime. Keep the directory (via the .gitkeep inside it) but ignore the
# artifacts. Match any output/ dir in the tree.
output/*
!output/.gitkeep

# ---- Docker ----------------------------------------------------------------
# Local override files for compose (per-subproject and root).
docker-compose.override.yml
.env

# ---- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store