# Copy to `.env` to override defaults. Safe to leave as-is for local dev.
#
# These are read by docker-compose.yml and flow into the postgres container
# (as POSTGRES_* env vars) and into the capture service (as PG_* for the
# probe). HOST_UID/GID are auto-set by the Makefile; don't edit them here.
POSTGRES_DB=packets
POSTGRES_USER=packets
POSTGRES_PASSWORD=packets