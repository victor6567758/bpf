# eBPF dev/runtime image: clang/llvm (BPF backend), libbpf, and a
# source-built bpftool (the distro package is tied to an exact kernel
# version, which breaks inside containers - building it ourselves avoids
# that entirely).
FROM ubuntu:24.04 AS bpftool-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential clang llvm libelf-dev libssl-dev zlib1g-dev \
    pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/libbpf/bpftool.git /tmp/bpftool \
    && cd /tmp/bpftool && git submodule update --init --recursive \
    && cd src && make -j"$(nproc)" \
    && install -m 0755 bpftool /usr/local/bin/bpftool

# ---------------------------------------------------------------------------
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang llvm libbpf-dev libelf1 libelf-dev zlib1g-dev pkg-config \
    cmake make gdb git iproute2 tcpdump ca-certificates \
    iputils-ping netcat-openbsd curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bpftool-builder /usr/local/bin/bpftool /usr/local/bin/bpftool

WORKDIR /work
COPY . /work

# Make the in-container scripts executable. (chmod at COPY time isn't
# preserved reliably across build contexts, so we enforce them here.)
RUN chmod +x /work/scripts/core-entrypoint.sh /work/scripts/send-traffic.sh

# One command does it all: create veth pair, build, attach XDP logger, send
# test traffic, stream the log. On `docker compose down` the container
# receives SIGTERM and the entrypoint's trap cleans everything up.
CMD ["/work/scripts/core-entrypoint.sh"]
